<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Tickets - Eventify</title>
    <link rel="stylesheet" href="/globals.css">
    <link rel="stylesheet" href="/ticket.css">
    <link rel="stylesheet" href="/responsive.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <%- include('partials/header') %>

    <main class="main-content">
        <div class="container">
            <div class="page-header">
                <h1 class="page-title">
                    <i class="fas fa-ticket-alt"></i>
                    My Tickets
                </h1>
                <p class="page-subtitle">View all your booked event tickets</p>
            </div>

            <% if (bookings && bookings.length > 0) { %>
                <div class="tickets-grid">
                    <% bookings.forEach(booking => { %>
                        <div class="ticket-card">
                            <div class="ticket-header">
                                <div class="event-image">
                                    <% if (booking.eventId && booking.eventId.image) { %>
                                        <img src="<%= booking.eventId.image %>" alt="<%= booking.eventId.title %>" loading="lazy">
                                    <% } else { %>
                                        <div class="no-image">
                                            <i class="fas fa-calendar-alt"></i>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="ticket-status">
                                    <span class="status-badge completed">
                                        <i class="fas fa-check-circle"></i>
                                        Completed
                                    </span>
                                </div>
                            </div>

                            <div class="ticket-content">
                                <h3 class="event-title">
                                    <%= booking.eventId ? booking.eventId.title : 'Event Not Found' %>
                                </h3>
                                
                                <div class="ticket-details">
                                    <div class="detail-item">
                                        <i class="fas fa-calendar"></i>
                                        <span>
                                            <%= booking.eventId ? new Date(booking.eventId.date).toLocaleDateString('en-US', {
                                                weekday: 'long',
                                                year: 'numeric',
                                                month: 'long',
                                                day: 'numeric'
                                            }) : 'Date not available' %>
                                        </span>
                                    </div>
                                    
                                    <div class="detail-item">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <span>
                                            <%= booking.eventId ? booking.eventId.location : 'Location not available' %>
                                        </span>
                                    </div>
                                    
                                    <div class="detail-item">
                                        <i class="fas fa-user"></i>
                                        <span><%= booking.customerName %></span>
                                    </div>
                                    
                                    <div class="detail-item">
                                        <i class="fas fa-phone"></i>
                                        <span><%= booking.customerPhone %></span>
                                    </div>
                                    
                                    <div class="detail-item">
                                        <i class="fas fa-ticket-alt"></i>
                                        <span><%= booking.quantity %> ticket<%= booking.quantity > 1 ? 's' : '' %></span>
                                    </div>
                                    
                                    <div class="detail-item">
                                        <i class="fas fa-rupee-sign"></i>
                                        <span>₹<%= booking.totalAmount.toFixed(2) %></span>
                                    </div>
                                    
                                    <% if (booking.couponApplied) { %>
                                        <div class="detail-item coupon-applied">
                                            <i class="fas fa-tag"></i>
                                            <span>Coupon Applied</span>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="booking-info">
                                    <div class="booking-date">
                                        <i class="fas fa-clock"></i>
                                        <span>Booked on: <%= new Date(booking.bookingDate).toLocaleDateString('en-US', {
                                            year: 'numeric',
                                            month: 'short',
                                            day: 'numeric',
                                            hour: '2-digit',
                                            minute: '2-digit'
                                        }) %></span>
                                    </div>
                                </div>
                            </div>

                            <div class="ticket-actions">
                                <a href="/booking/ticket/<%= booking._id %>" class="btn btn-primary">
                                    <i class="fas fa-eye"></i>
                                    View Ticket
                                </a>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="no-tickets">
                    <div class="no-tickets-icon">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                    <h3>No Tickets Found</h3>
                    <p>You haven't booked any events yet. Start exploring amazing events!</p>
                    <a href="/events" class="btn btn-primary">
                        <i class="fas fa-search"></i>
                        Browse Events
                    </a>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script>
        // Add any interactive functionality here
        document.addEventListener('DOMContentLoaded', function() {
            console.log('My Tickets page loaded');
        });
    </script>
</body>
</html>
