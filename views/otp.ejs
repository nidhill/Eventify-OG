<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Account | Eventify</title>
    <link rel="stylesheet" href="/otp.css"> 
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/loader') %>
    <div class="container">
        <div class="left-panel">
            <div class="logo">EVENTIFY</div>
            <div class="image-overlay"></div>
            <div class="left-content">
                <h1>Verify Your Account</h1>
                <p>
                    A simple step to get you started on your journey. Let's make sure it's really you!
                </p>
            </div>
        </div>
        <div class="right-panel">
            <div class="signup-box">
                <h2>EMAIL VERIFICATION</h2>
                <p>We've sent a 6-digit OTP to <strong><%= email %></strong>. Please enter it below to verify your account.</p>
                
                <% if (error) { %>
                    <p class="error-message"><%= error %></p>
                <% } %>

                <form action="/userauth/verify-otp" method="POST">
                    <input type="hidden" name="email" value="<%= email %>">
                    <div class="input-group">
                        <input type="text" name="otp" placeholder="Enter 6-digit OTP" required maxlength="6">
                    </div>
                    <button type="submit" class="create-account-btn">Verify Account</button>
                </form>

                <div class="login-link">
                    <p>Didn't receive the code? <a href="/userauth/resend-otp?email=<%= email %>">Resend OTP</a></p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>